<template>
  <div class="field-mapping-container">
    <h2>字段映射配置</h2>
    
    <!-- 任务状态显示 -->
    <div class="task-info" v-if="taskId">
      <p>当前任务ID: {{ taskId }}</p>
      <button @click="loadPreview" :disabled="loading" class="btn">
        {{ loading ? '加载中...' : '加载字段预览' }}
      </button>
    </div>
    
    <!-- 加载状态 -->
    <div v-if="loading" class="loading">
      <p>正在分析文档字段...</p>
    </div>
    
    <!-- 字段预览区域 -->
    <div v-if="previewData" class="preview-section">
      <h3>字段预览与映射建议</h3>
      
      <div class="stats">
        <div class="stat-item">
          <span class="label">总字段数:</span>
          <span class="value">{{ previewData?.total_fields || 0 }}</span>
        </div>
        <div class="stat-item">
          <span class="label">已匹配:</span>
          <span class="value success">{{ previewData?.matched_fields?.length || 0 }}</span>
        </div>
        <div class="stat-item">
          <span class="label">待处理:</span>
          <span class="value warning">{{ previewData?.unmatched_fields?.length || 0 }}</span>
        </div>
      </div>
      
      <!-- 已匹配字段 -->
      <div class="matched-section" v-if="previewData?.matched_fields?.length > 0">
        <h4>已自动匹配的字段</h4>
        <div class="field-list">
          <div 
            v-for="field in previewData?.matched_fields || []" 
            :key="field.original"
            class="field-item matched"
          >
            <span class="original-field">{{ field.original }}</span>
            <span class="arrow">→</span>
            <span class="mapped-field">{{ field.matched }}</span>
            <span class="confidence" :class="getConfidenceClass(field.confidence)">
              ({{ (field.confidence * 100).toFixed(0) }}%)
            </span>
            <span class="match-type">{{ getMatchTypeText(field.type) }}</span>
          </div>
        </div>
      </div>
      
      <!-- 需要人工处理的字段 -->
      <div class="unmatched-section" v-if="previewData?.unmatched_fields?.length > 0">
        <h4>字段映射工作区</h4>
        
        <div class="mapping-workspace">
          <!-- 左侧：待映射字段 -->
          <div class="source-fields-panel">
            <h5>待映射字段</h5>
            <div class="field-list">
              <div 
                v-for="field in previewData?.unmatched_fields || []" 
                :key="field.original"
                class="draggable-field source-field"
                draggable="true"
                @dragstart="handleDragStart($event, field.original)"
                @dragend="handleDragEnd($event)"
              >
                <div class="field-content">
                  <span class="field-name">{{ field.original }}</span>
                  <span class="field-status">未映射</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- 中间：连接区域 -->
          <div class="connection-panel">
            <h5>映射连接</h5>
            <div 
              class="connection-area"
              @drop="handleWorkspaceDrop($event)"
              @dragover="handleDragOver($event)"
            >
              <!-- 显示已建立的连接线 -->
              <div 
                v-for="mapping in mappings" 
                :key="`${mapping.original}-${mapping.target}`"
                class="mapping-connection"
                @click="removeMapping(mapping.original)"
              >
                <div class="connection-source">{{ mapping.original }}</div>
                <div class="connection-line">
                  <svg width="100%" height="20">
                    <line x1="0" y1="10" x2="100%" y2="10" stroke="#007bff" stroke-width="2" marker-end="url(#arrowhead)"/>
                  </svg>
                </div>
                <div class="connection-target">{{ mapping.target }}</div>
                <div class="remove-connection" title="删除映射">×</div>
              </div>
              
              <!-- 拖拽预览线 -->
              <div v-if="isDragging" class="drag-preview-line" :style="dragPreviewStyle"></div>
            </div>
            
            <!-- SVG 箭头定义 -->
            <svg width="0" height="0" style="position: absolute">
              <defs>
                <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                  <polygon points="0 0, 10 3.5, 0 7" fill="#007bff"/>
                </marker>
              </defs>
            </svg>
          </div>
          
          <!-- 右侧：目标字段 -->
          <div class="target-fields-panel">
            <h5>目标字段</h5>
            <div class="field-list">
              <div 
                v-for="field in standardTargetFields" 
                :key="field"
                class="droppable-field target-field"
                @drop="handleDrop($event, field)"
                @dragover="handleDragOver($event)"
                @dragenter="handleDragEnter($event, field)"
                @dragleave="handleDragLeave($event, field)"
              >
                <div class="field-content">
                  <span class="field-name">{{ field }}</span>
                  <span class="field-count">{{ getFieldMappingCount(field) }}个映射</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- 映射统计 -->
        <div class="mapping-stats" v-if="mappings.length > 0">
          <span>已建立 {{ mappings.length }} 个映射关系</span>
          <button @click="clearAllMappings" class="btn secondary small">清空所有映射</button>
        </div>
      </div>
      
      <!-- 应用映射按钮 -->
      <div class="action-section" v-if="mappings.length > 0">
        <button @click="applyMappings" class="btn primary" :disabled="applying">
          {{ applying ? '应用中...' : `应用 ${mappings.length} 个映射` }}
        </button>
        <button @click="clearMappings" class="btn secondary">
          清空映射
        </button>
      </div>
    </div>
    
    <!-- 映射历史 -->
    <div class="history-section" v-if="mappingHistory.length > 0">
      <h3>映射历史</h3>
      <div class="history-list">
        <div 
          v-for="history in mappingHistory" 
          :key="history.id"
          class="history-item"
        >
          <span>{{ history.message }}</span>
          <span class="timestamp">{{ history.timestamp }}</span>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, computed } from 'vue'
import { useToastStore } from '../stores/ui'
import { api } from '../api'

const props = defineProps<{
  taskId?: string
}>()

const toast = useToastStore()

// 状态管理
const loading = ref(false)
const applying = ref(false)
const previewData = ref<any>(null)
const mappings = reactive<Array<{original: string, target: string, confidence: number}>>([])
const mappingHistory = reactive<Array<{id: string, message: string, timestamp: string}>>([])

// 标准目标字段
const standardTargetFields = [
  'ID', '参数', '内容', '信号名称', '数据类型', '类型', 
  '长度', '字节', '单位', '备注', '值域', '信源', '信宿', 
  '信息内容', '消息ID', '接口名称', '时间戳', '转换类型'
]

// 拖拽状态
const draggedField = ref<string>('')
const isDragging = ref(false)
const dragPosition = ref({x: 0, y: 0})
const dropTarget = ref<string>('')

// 拖拽预览线样式
const dragPreviewStyle = computed(() => {
  if (!isDragging.value) return {}
  return {
    left: `${dragPosition.value.x}px`,
    top: `${dragPosition.value.y}px`
  }
})

// 方法定义
async function loadPreview() {
  if (!props.taskId) {
    toast.show('请先创建任务')
    return
  }
  
  loading.value = true
  try {
    // 并行加载预览数据和用户映射
    const [previewResponse, mappingsResponse] = await Promise.all([
      api.get(`/mapping/preview/${props.taskId}`),
      api.get('/mapping/user-mappings')
    ])
    
    previewData.value = previewResponse.data?.data || null
    
    // 加载已保存的用户映射
    if (mappingsResponse.data?.data?.mappings) {
      const savedMappings = mappingsResponse.data.data.mappings
      // 将保存的映射转换为当前格式
      Object.entries(savedMappings).forEach(([original, mappingData]: [string, any]) => {
        const existingIndex = mappings.findIndex(m => m.original === original)
        const mapping = {
          original: original,
          target: mappingData.target,
          confidence: mappingData.confidence || 0.8
        }
        
        if (existingIndex >= 0) {
          mappings[existingIndex] = mapping
        } else {
          mappings.push(mapping)
        }
      })
      
      if (Object.keys(savedMappings).length > 0) {
        toast.show(`已加载 ${Object.keys(savedMappings).length} 个已保存的映射关系`)
      }
    }
    
    toast.show('字段预览加载成功')
  } catch (error: any) {
    toast.show('加载失败: ' + (error.message || '未知错误'))
  } finally {
    loading.value = false
  }
}

function selectSuggestion(originalField: string, targetField: string) {
  // 添加到映射列表
  const existingIndex = mappings.findIndex(m => m.original === originalField)
  const mapping = {
    original: originalField,
    target: targetField,
    confidence: 0.85
  }
  
  if (existingIndex >= 0) {
    mappings[existingIndex] = mapping
  } else {
    mappings.push(mapping)
  }
  
  toast.show(`已选择映射: ${originalField} → ${targetField}`)
}

function addCustomMapping(originalField: string) {
  const inputElement = document.querySelector(`[ref="custom-${originalField}"]`) as HTMLInputElement
  const targetField = inputElement?.value.trim()
  
  if (!targetField) {
    toast.show('请输入目标字段名')
    return
  }
  
  const existingIndex = mappings.findIndex(m => m.original === originalField)
  const mapping = {
    original: originalField,
    target: targetField,
    confidence: 0.9
  }
  
  if (existingIndex >= 0) {
    mappings[existingIndex] = mapping
  } else {
    mappings.push(mapping)
  }
  
  // 清空输入框
  if (inputElement) {
    inputElement.value = ''
  }
  
  toast.show(`已添加自定义映射: ${originalField} → ${targetField}`)
}

async function applyMappings() {
  if (!props.taskId || mappings.length === 0) {
    toast.show('没有可应用的映射')
    return
  }
  
  applying.value = true
  try {
    const response = await api.post('/mapping/apply', {
      task_id: props.taskId,
      mappings: mappings
    })
    
    if (response.data.success) {
      const historyItem = {
        id: Date.now().toString(),
        message: `成功应用 ${response.data.applied_count} 个字段映射`,
        timestamp: new Date().toLocaleTimeString()
      }
      mappingHistory.push(historyItem)
      
      toast.show('字段映射应用成功')
      // 清空当前映射
      mappings.length = 0
    }
  } catch (error: any) {
    toast.show('应用失败: ' + (error.message || '未知错误'))
  } finally {
    applying.value = false
  }
}

function clearMappings() {
  mappings.length = 0
  toast.show('已清空映射列表')
}

function getConfidenceClass(confidence: number) {
  if (confidence >= 0.9) return 'high'
  if (confidence >= 0.7) return 'medium'
  return 'low'
}

function getMatchTypeText(type: string) {
  const typeMap: Record<string, string> = {
    'exact': '精确匹配',
    'fuzzy': '模糊匹配',
    'alias': '别名映射',
    'semantic': '语义匹配'
  }
  return typeMap[type] || type
}

// 拖拽处理函数
function handleDragStart(event: DragEvent, fieldName: string) {
  draggedField.value = fieldName
  isDragging.value = true
  event.dataTransfer!.effectAllowed = 'move'
}

function handleDragEnd(event: DragEvent) {
  isDragging.value = false
  dropTarget.value = ''
}

function handleDragOver(event: DragEvent) {
  event.preventDefault()
  event.dataTransfer!.dropEffect = 'move'
}

function handleDragEnter(event: DragEvent, targetField: string) {
  event.preventDefault()
  dropTarget.value = targetField
  const targetElement = event.target as HTMLElement
  if (targetElement) {
    targetElement.classList.add('drag-over')
  }
}

function handleDragLeave(event: DragEvent, targetField: string) {
  const targetElement = event.target as HTMLElement
  if (targetElement) {
    targetElement.classList.remove('drag-over')
  }
}

function handleDrop(event: DragEvent, targetField: string) {
  event.preventDefault()
  const targetElement = event.target as HTMLElement
  if (targetElement) {
    targetElement.classList.remove('drag-over')
  }
  
  if (draggedField.value && targetField) {
    // 检查是否已存在相同的映射
    const existingIndex = mappings.findIndex(m => m.original === draggedField.value)
    const mapping = {
      original: draggedField.value,
      target: targetField,
      confidence: 0.9
    }
    
    if (existingIndex >= 0) {
      mappings[existingIndex] = mapping
    } else {
      mappings.push(mapping)
    }
    
    toast.show(`已建立映射: ${draggedField.value} → ${targetField}`)
    draggedField.value = ''
  }
  dropTarget.value = ''
}

function handleWorkspaceDrop(event: DragEvent) {
  event.preventDefault()
  // 在工作区空白处释放，清除拖拽状态
  draggedField.value = ''
  isDragging.value = false
  dropTarget.value = ''
}

function getFieldMappingCount(targetField: string): number {
  return mappings.filter(m => m.target === targetField).length
}

function removeMapping(originalField: string) {
  const index = mappings.findIndex(m => m.original === originalField)
  if (index >= 0) {
    const mapping = mappings[index]
    mappings.splice(index, 1)
    toast.show(`已删除映射: ${mapping.original} → ${mapping.target}`)
  }
}

function clearAllMappings() {
  if (confirm(`确定要清空所有 ${mappings.length} 个映射关系吗？`)) {
    mappings.length = 0
    toast.show('已清空所有映射关系')
  }
}

// 监听任务ID变化
// watch(() => props.taskId, (newTaskId) => {
//   if (newTaskId) {
//     loadPreview()
//   }
// })
</script>

<style scoped>
