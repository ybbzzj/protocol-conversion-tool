}

.field-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 12px;
  background: #ffc107;
  color: #212529;
}

.field-count {
  font-size: 12px;
  color: #6c757d;
}

.target-field .field-status {
  background: #17a2b8;
  color: white;
}

/* 连接区域样式 */
.connection-area {
  min-height: 300px;
  position: relative;
  background: #f8f9fa;
  border-radius: 4px;
  border: 1px dashed #ced4da;
}

.mapping-connection {
  display: flex;
  align-items: center;
  padding: 10px;
  margin: 10px 0;
  background: white;
  border-radius: 6px;
  border: 1px solid #007bff;
  box-shadow: 0 2px 4px rgba(0,123,255,0.1);
  cursor: pointer;
  transition: all 0.2s ease;
}

.mapping-connection:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,123,255,0.2);
}

.connection-source, .connection-target {
  flex: 1;
  text-align: center;
  font-weight: 500;
  color: #495057;
}

.connection-line {
  flex: 2;
  height: 20px;
  position: relative;
}

.remove-connection {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 20px;
  height: 20px;
  background: #dc3545;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.remove-connection:hover {
  background: #c82333;
  transform: scale(1.1);
}

/* 拖拽预览线 */
.drag-preview-line {
  position: absolute;
  pointer-events: none;
  z-index: 1000;
}

.drag-preview-line::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 2px;
  background: #007bff;
  border-radius: 1px;
}

/* 映射统计 */
.mapping-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
  padding: 15px;
  background: #e3f2fd;
  border-radius: 6px;
  border: 1px solid #bbdefb;
}

.mapping-stats span {
  font-weight: 500;
  color: #1976d2;
}

.btn.small {
  padding: 6px 12px;
  font-size: 12px;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn.primary {
  background: #1976d2;
  color: white;
}

.btn.secondary {
  background: #757575;
  color: white;
}

.loading {
