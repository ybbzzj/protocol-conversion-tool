  font-weight: bold;
}

.status-tag.warning {
  background: #ff9800;
  color: white;
}

.arrow {
  margin: 0 10px;
  color: #666;
}

.mapped-field {
  font-weight: bold;
  color: #1976d2;
}

.confidence {
  margin-left: 10px;
  font-size: 14px;
}

.confidence.high { color: #4CAF50; }
.confidence.medium { color: #FF9800; }
.confidence.low { color: #F44336; }

.match-type {
  margin-left: 10px;
  font-size: 12px;
